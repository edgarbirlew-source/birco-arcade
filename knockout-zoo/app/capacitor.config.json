{
  "appId": "com.birco.knockoutzoo",
  "appName": "Knockout Zoo",
  "webDir": "www",
  "backgroundColor": "#0c0a14",
  "android": {
    "backgroundColor": "#0c0a14"
  },
  "ios": {
    "backgroundColor": "#0c0a14",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0c0a14",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true
    },
    "SystemBars": {
      "insetsHandling": "css"
    }
  }
}
